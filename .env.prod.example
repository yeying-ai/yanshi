# Production environment template for Yanshi on `cu` (`https://yanshi.yeying.dev`).
# Copy to `/data/yanshi-prod/.env` (`chmod 600`) on the target server.

POSTGRES_DB=yanshi
POSTGRES_USER=yanshi
POSTGRES_PASSWORD=replace-with-32-byte-random-hex

YANSHI_HOST_PORT=18080
YANSHI_DATA_HOST_DIR=/data/yanshi-prod/data
CERT_HOST_DIR=/data/yanshi-prod/certs
TLS_CERT_FILE=yeying.dev.cert
TLS_KEY_FILE=yeying.dev.key

# Pingora gateway routing (`crates/gateway`)
HOST_UPSTREAMS=yanshi.yeying.dev=127.0.0.1:18080
HOST_REDIRECTS=www.yanshi.yeying.dev=https://yanshi.yeying.dev
SNI_CERTS=
GATEWAY_RUST_LOG=info

# Yanshi gateway security & policy
YANSHI_CORS_ALLOWED_ORIGINS=https://yanshi.yeying.dev
YANSHI_API_TOKEN=replace-with-32-byte-random-hex
YANSHI_API_TOKEN_TENANTS=
YANSHI_GATEWAY_HOST_NODE_TYPES=file,agent,skill_agent,multi_agent,shell
YANSHI_GATEWAY_ALLOWED_COMMANDS=ffmpeg,ffprobe,typst,pandoc,d2,pdftotext,yt-dlp
YANSHI_GENERATE_MODEL=deepseek-v4-flash
YANSHI_PRICING_TABLE=/etc/yanshi/pricing.yml
YANSHI_RUN_MAX_CONCURRENCY=4
CARGO_BUILD_JOBS=2
RUST_LOG=info

# Optional LLM provider credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GLM_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
STEPFUN_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
KLING_API_KEY=

# Optional web_search & GitHub API credentials (falls back to zero-key search if unset)
TAVILY_API_KEY=
BOCHA_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=
GITHUB_TOKEN=
